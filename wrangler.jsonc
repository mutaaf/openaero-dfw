{
  // openaero-dfw: static assets under mutaafaziz.com/openaero/ plus a small edge API.
  // The route takes precedence over the mutaafaziz.com Custom Domain (the personal site).
  // Operator-owned file (agents/control.json → frozen_paths).
  "name": "openaero-dfw",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": true,
  "previews": {},
  // The Worker script only runs for /openaero/api/* (today: the METAR proxy, src/worker/).
  // Everything else is served straight from static assets.
  "main": "src/worker/index.js",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/openaero/api/*"] },
  "routes": [{ "pattern": "mutaafaziz.com/openaero*", "zone_name": "mutaafaziz.com" }]
}
