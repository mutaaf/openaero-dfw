<?xml version="1.0"?>
<!--
  Lycoming IO-360-L2A as fitted to the Cessna 172S: 180 hp at 2700 rpm, 361 in³, four
  cylinders, 5.125 in bore × 4.375 in stroke, 8.5:1 compression (Lycoming type
  certificate data sheet E-286 and the 172S POH, Section 1). Written for OpenAero DFW
  from those published figures; MIT like the rest of the repository.
-->
<piston_engine name="io360">
  <minmp unit="INHG">6.5</minmp>
  <maxmp unit="INHG">29.9</maxmp>
  <displacement unit="IN3">361</displacement>
  <maxhp>180</maxhp>
  <cycles>4</cycles>
  <idlerpm>650</idlerpm>
  <maxrpm>2800</maxrpm>
  <sparkfaildrop>0.1</sparkfaildrop>
  <volumetric-efficiency>0.85</volumetric-efficiency>
  <static-friction unit="HP">1.5</static-friction>
  <starter-torque>400</starter-torque>
  <starter-rpm>1400</starter-rpm>
  <bore unit="IN">5.125</bore>
  <stroke unit="IN">4.375</stroke>
  <cylinders>4</cylinders>
  <compression-ratio>8.5</compression-ratio>
</piston_engine>
